            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Disease"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/org#changedBy -->

    <rdf:Description rdf:about="http://www.w3.org/ns/org#changedBy">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/org#hasMember -->

    <rdf:Description rdf:about="http://www.w3.org/ns/org#hasMember">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/org#hasMembership -->

    <rdf:Description rdf:about="http://www.w3.org/ns/org#hasMembership">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/org#Post"/>
                    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/org#Membership"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/org#Post"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/org#hasPrimarySite -->

    <rdf:Description rdf:about="http://www.w3.org/ns/org#hasPrimarySite">

    <!-- http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Accelerometer_3Axis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Accelerometer_3Axis">
        <rdf:type rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Medical-Sensor"/>
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/isHostedBy"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/detects"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/Stimulus"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/implements"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/implements"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdf:type>
        <IoMT-o:implements rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Movement_Classification_Service"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Body_Movements -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Body_Movements">

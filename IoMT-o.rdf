        </rdf:type>
        <IoMT-o:hosts rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Accelerometer_3Axis"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Movement_Classification_Service -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Movement_Classification_Service">
        <rdf:type rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#IoMT-service"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/hasOutput"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/Output"/>
            </owl:Restriction>
        </rdf:type>
        <IoMT-o:hasOutput rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Body_Movements"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Sleep_Disorder -->


        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/org#hasUnit -->

    <rdf:Description rdf:about="http://www.w3.org/ns/org#hasUnit">

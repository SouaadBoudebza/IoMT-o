        <IoMT-o:is_indicator rdf:resource="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Sleep_Disorder"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Connected_Bracelet -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/souad/ontologies/2026/9/IoMT-o#Connected_Bracelet">
